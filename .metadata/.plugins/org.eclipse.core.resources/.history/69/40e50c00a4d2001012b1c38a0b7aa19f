#define NO_ERROR 0

void clearwinsock() {
#if defined WIN32
    WSACleanup();
#endif
}

// Funzioni di generazione dati meteo
float get_temperature() {
    return -10.0 + (rand() / (float)RAND_MAX) * 50.0;
}

float get_humidity() {
    return 20.0 + (rand() / (float)RAND_MAX) * 80.0;
}

float get_wind() {
    return (rand() / (float)RAND_MAX) * 100.0;
}

float get_pressure() {
    return 950.0 + (rand() / (float)RAND_MAX) * 100.0;
}

// Confronto case-insensitive
int strcasecmp_custom(const char *s1, const char *s2) {
    while (*s1 && *s2) {
        if (tolower(*s1) != tolower(*s2))
            return tolower(*s1) - tolower(*s2);
        s1++;
        s2++;
    }
    return tolower(*s1) - tolower(*s2);
}

// Verifica se la città è supportata
int is_valid_city(const char *city) {
    const char *citta_supportate[] = {
        "Bari", "Roma", "Milano", "Napoli", "Torino",
        "Palermo", "Genova", "Bologna", "Firenze", "Venezia"
    };
    int num_citta = 10;

    for (int i = 0; i < num_citta; i++) {
        if (strcasecmp_custom(city, citta_supportate[i]) == 0)
            return 1;
    }
    return 0;
}

// Verifica validità caratteri nella città
int has_invalid_chars(const char *city) {
    for (int i = 0; city[i] != '\0'; i++) {
        if (city[i] == '\t' || city[i] == '@' || city[i] == '#' ||
            city[i] == '$' || city[i] == '%' || city[i] == '&' ||
            city[i] == '*' || city[i] == '!' || city[i] == '?')
            return 1;
    }
    return 0;
}

// Processa la richiesta
void process_request(struct request *req, struct response *resp) {
    resp->type = req->type;

    // Verifica validità tipo
    if (req->type != 't' && req->type != 'h' &&
        req->type != 'w' && req->type != 'p') {
        resp->status = 2;
        resp->value = 0.0;
        return;
    }

    // Verifica caratteri invalidi
    if (has_invalid_chars(req->city)) {
        resp->status = 2;
        resp->value = 0.0;
        return;
    }

    // Verifica città supportata
    if (!is_valid_city(req->city)) {
        resp->status = 1;
        resp->value = 0.0;
        return;
    }

    // Genera dato meteo
    resp->status = 0;
    switch (req->type) {
        case 't':
            resp->value = get_temperature();
            break;
        case 'h':
            resp->value = get_humidity();
            break;
        case 'w':
            resp->value = get_wind();
            break;
        case 'p':
            resp->value = get_pressure();
            break;
    }
}

int main(int argc, char *argv[]) {
    int porta = DEFAULT_PORT;

    // Parsing argomenti
    for (int i = 1; i < argc; i++) {
        if (strcmp(argv[i], "-p") == 0 && i + 1 < argc) {
            porta = atoi(argv[i + 1]);
            i++;
        }
    }

    srand(time(NULL));

#if defined WIN32
    WSADATA wsa_data;
    int result = WSAStartup(MAKEWORD(2,2), &wsa_data);
    if (result != NO_ERROR) {
        printf("Error at WSAStartup()\n");
        return 0;
    }
#endif

    int my_socket;
    struct sockaddr_in indirizzo_server, indirizzo_client;
    unsigned int lunghezza_client;

    // Creazione socket
    my_socket = socket(PF_INET, SOCK_DGRAM, IPPROTO_UDP);
    if (my_socket < 0) {
        printf("socket() failed\n");
        clearwinsock();
        return 0;
    }

    // Configurazione indirizzo server
    memset(&indirizzo_server, 0, sizeof(indirizzo_server));
    indirizzo_server.sin_family = AF_INET;
    indirizzo_server.sin_port = htons(porta);
    indirizzo_server.sin_addr.s_addr = htonl(INADDR_ANY);

    // Bind
    if (bind(my_socket, (struct sockaddr *)&indirizzo_server, sizeof(indirizzo_server)) < 0) {
        printf("bind() failed\n");
        closesocket(my_socket);
        clearwinsock();
        return 0;
    }

    printf("Server in ascolto sulla porta %d...\n", porta);

    // Loop principale
    while (1) {
        char buffer_richiesta[REQUEST_SIZE];
        char buffer_risposta[RESPONSE_SIZE];
        struct request req;
        struct response resp;

        lunghezza_client = sizeof(indirizzo_client);

        // Ricezione richiesta
        int bytes_ricevuti = recvfrom(my_socket, buffer_richiesta, REQUEST_SIZE, 0,
                                      (struct sockaddr *)&indirizzo_client, &lunghezza_client);

        if (bytes_ricevuti < 0) {
            continue;
        }

        // Deserializzazione richiesta
        int offset = 0;
        memcpy(&req.type, buffer_richiesta + offset, sizeof(char));
        offset += sizeof(char);
        memcpy(req.city, buffer_richiesta + offset, 64);
        req.city[63] = '\0';

        // Risoluzione DNS client
        struct hostent *host_client;
        host_client = gethostbyaddr((char *)&indirizzo_client.sin_addr,
                                   sizeof(indirizzo_client.sin_addr), AF_INET);

        char *nome_client = (host_client != NULL) ? host_client->h_name : "unknown";

        printf("Richiesta ricevuta da %s (ip %s): type='%c', city='%s'\n",
               nome_client, inet_ntoa(indirizzo_client.sin_addr), req.type, req.city);

        // Processa richiesta
        process_request(&req, &resp);

        // Serializzazione risposta
        offset = 0;
        uint32_t net_status = htonl(resp.status);
        memcpy(buffer_risposta + offset, &net_status, sizeof(uint32_t));
        offset += sizeof(uint32_t);

        memcpy(buffer_risposta + offset, &resp.type, sizeof(char));
        offset += sizeof(char);

        uint32_t temp;
        memcpy(&temp, &resp.value, sizeof(float));
        temp = htonl(temp);
        memcpy(buffer_risposta + offset, &temp, sizeof(float));
        offset += sizeof(float);

        // Invio risposta
        sendto(my_socket, buffer_risposta, offset, 0,
               (struct sockaddr *)&indirizzo_client, lunghezza_client);
    }

    closesocket(my_socket);
    clearwinsock();
    return 0;
}
