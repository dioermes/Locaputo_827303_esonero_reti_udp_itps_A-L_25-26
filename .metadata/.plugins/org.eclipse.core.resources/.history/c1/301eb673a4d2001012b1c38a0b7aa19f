// Porta di default
#define SERVER_PORT 56700

// Status codes
#define STATUS_OK 0
#define STATUS_CITY_NOT_FOUND 1
#define STATUS_INVALID_REQUEST 2

// Struttura richiesta client
typedef struct {
    char type;      // 't'=temperatura, 'h'=umidità, 'w'=vento, 'p'=pressione
    char city[64];  // nome città (null-terminated)
} weather_request_t;

// Struttura risposta server
typedef struct {
    unsigned int status;  // 0=successo, 1=città non trovata, 2=richiesta invalida
    char type;            // eco del tipo richiesto
    float value;          // dato meteo generato
} weather_response_t;

// Funzione per confronto case-insensitive su Linux
#ifndef WIN32
int strcasecmp(const char *s1, const char *s2);
#else
#define strcasecmp _stricmp
#endif

